# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bg_recommendations
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/bg_recommendations

# Security
# IMPORTANT: Generate a secure secret key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production-must-be-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Environment
ENVIRONMENT=development
DEBUG=True

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=Board Game Recommendations System
