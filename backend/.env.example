# Environment Configuration for CJEI Recommendation System
# Copy this file to .env and configure with your values

# Application
PROJECT_NAME="CJEI Board Game Recommendation System"
VERSION="1.0.0"
API_PREFIX="/api"

# Database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://cjei:cjei@localhost:5432/cjei_recommendations

# Security
# Generate a secure secret key: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
